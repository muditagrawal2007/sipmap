# GitHub App credentials (NEVER commit real values)
# Copy this file to .env and fill in values from your GitHub App settings.

# App ID (numeric, from GitHub App settings page)
APP_ID=

# Webhook secret (string you set when registering the App)
WEBHOOK_SECRET=

# Path to the App's private key (.pem file downloaded from GitHub)
PRIVATE_KEY_PATH=./private-key.pem

# Or alternatively, paste the key content directly (less secure)
# PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Glitch will inject PORT; locally default to 3000
PORT=3000

# Logging level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Set to "true" only when debugging locally — never in production
DEBUG=false

# Public homepage URL shown in the GitHub App listing
HOMEPAGE_URL=https://github.com/muditagrawal2007/sipmap

# Optional: Smee.io channel URL for local webhook proxying
# SMEE_URL=
